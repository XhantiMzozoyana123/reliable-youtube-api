{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Enabled": false,
    "Mode": "Keys",
    "AllowedKeys": [],
    "RapidApiProxySecret": ""
  },
  "DownloadJobs": {
    "PublicBaseUrl": "http://localhost:5000",
    "OutputRetentionMinutes": 60,
    "OutputDirectory": "App_Data/jobs",
    "Persistence": "FileSystem",
    "MaxAttempts": 3,
    "JobTimeoutSeconds": 300,
    "MaxConcurrency": 4,
    "Provider": "Simulated",
    "YtDlpPath": "yt-dlp"
  }
}
